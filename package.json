{
  "name": "fetchdeck",
  "private": true,
  "version": "1.0.0",
  "description": "Parallel download manager for desktop.",
  "type": "module",
  "workspaces": [
    "engine",
    "queue",
    "app"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p engine && tsc -p queue && tsc -p app",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test",
    "bench": "tsx engine/bench/bench.ts",
    "dist": "npm run dist -w app"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tejaswasnik/Fetchdeck.git"
  },
  "keywords": [
    "download-manager",
    "downloader",
    "parallel-downloads",
    "resumable-downloads",
    "electron",
    "typescript"
  ],
  "author": "Tejas Wasnik <tejaswasnik.me@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tejaswasnik/Fetchdeck/issues"
  },
  "homepage": "https://github.com/tejaswasnik/Fetchdeck#readme",
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "jsdom": "^31.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.11"
  }
}
